<?xml version="1.0"?>
<robot name="robot_arm_6dof">

  <!-- World Link -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0325" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.065"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0325" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.065"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0325" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.00049" ixy="0" ixz="0" iyy="0.00049" iyz="0" izz="0.00074"/>
    </inertial>
  </link>

  <!-- Joint 1: Base Yaw -->
  <joint name="base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_mount"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="2.5" velocity="1.5"/>
  </joint>

  <!-- Shoulder Mount Link -->
  <link name="shoulder_mount">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.04"/>
      </geometry>
      <material name="metallic_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Joint 2: Shoulder Pitch -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="shoulder_mount"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="3.0" velocity="1.5"/>
  </joint>

  <!-- Upper Arm Link (105mm length) -->
  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.105"/>
      </geometry>
      <material name="metallic_silver">
        <color rgba="0.75 0.75 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.105"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Joint 3: Elbow Pitch -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="2.5" velocity="1.5"/>
  </joint>

  <!-- Forearm Link (100mm length) -->
  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.100"/>
      </geometry>
      <material name="metallic_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.100"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.00016" ixy="0" ixz="0" iyy="0.00016" iyz="0" izz="0.00004"/>
    </inertial>
  </link>

  <!-- Joint 4: Wrist Pitch -->
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="forearm"/>
    <child link="wrist_mount"/>
    <origin xyz="0 0 0.100" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.5" velocity="2.0"/>
  </joint>

  <!-- Wrist Mount Link (70mm length) -->
  <link name="wrist_mount">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.070"/>
      </geometry>
      <material name="metallic_silver">
        <color rgba="0.75 0.75 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.070"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Joint 5: Wrist Roll -->
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_mount"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.070" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1.0" velocity="2.5"/>
  </joint>

  <!-- Gripper Base Link -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.03"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Joint 6: Gripper Finger Left -->
  <joint name="gripper_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_finger_left"/>
    <origin xyz="0.015 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.025" effort="1.0" velocity="0.5"/>
  </joint>

  <link name="gripper_finger_left">
    <visual>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.015 0.055"/>
      </geometry>
      <material name="metallic_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.015 0.055"/>
      </geometry>
    </collision>
  </link>

  <!-- End Effector Tool Center Point (TCP) -->
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <link name="tcp_link"/>

</robot>
